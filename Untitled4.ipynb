   "source": [
    "# Write a program that will reverse a four digit number.Also it checks whether the reverse is true."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "946cd0c1-b41a-49ad-8786-0aacb56975ad",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter your 4 digit number:  44444\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "reverse no: 44444\n",
      "True\n"
     ]
    }
   ],
   "source": [
    "n = input(\"Enter your 4 digit number: \")\n",
    "\n",
    "reverse = n[::-1]\n",
    "\n",
    "print(\"reverse no:\", reverse)\n",
    "\n",
    "if n == reverse:\n",
    "    print(\"True\")\n",
    "else:\n",
    "    print(\"False\")"
   ]
  },
