   "source": [
    "# Write a program that will tell whether the number entered by the user is odd or even."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "f835ae2b-7852-4873-b437-d59c07c8fccb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter your number : 2\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Even\n"
     ]
    }
   ],
   "source": [
    "num = int(input(\"Enter your number :\"))\n",
    "\n",
    "if num % 2 == 0:\n",
    "          print(\"Even\")\n",
    "else:\n",
    "          print(\"Odd\")"
   ]
  },
